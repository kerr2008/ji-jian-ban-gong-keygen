# -*- coding: utf-8 -*-
"""
媒体下载模块 v1.0
支持平台：抖音/TikTok、快手、小红书、X/Twitter
功能：下载视频（去水印）、下载图片、复制文案
"""

import os
import re
import json
import tkinter as tk
from tkinter import ttk, filedialog, messagebox
from datetime import datetime
from pathlib import Path
import threading


# ==================== 核心下载引擎 ====================

def parse_urls(text):
    """从文本中提取所有URL"""
    urls = re.findall(r"https?://[^\s\u4e00-\u9fff\uff00-\uffef\u3000-\u303f]+", text)
    return list(set(urls))


def _get_ydl_opts(output_dir, quality="best", extract_audio=False):
    """获取 yt-dlp 通用参数"""
    if quality == "best":
        format_spec = "bestvideo*+bestaudio/best"
    elif quality == "1080p":
        format_spec = "bestvideo[height<=1080]+bestaudio/best[height<=1080]"
    elif quality == "720p":
        format_spec = "bestvideo[height<=720]+bestaudio/best[height<=720]"
    elif quality == "480p":
        format_spec = "bestvideo[height<=480]+bestaudio/best[height<=480]"
    else:
        format_spec = "best"

    opts = {
        "outtmpl": os.path.join(output_dir, "%(title)s_%(id)s.%(ext)s"),
        "format": format_spec,
        "merge_output_format": "mp4",
        "quiet": True,
        "no_warnings": True,
        "extract_flat": False,
        "ignoreerrors": True,
        "nooverwrites": False,
    }

    if extract_audio:
        opts["postprocessors"] = [{
            "key": "FFmpegExtractAudio",
            "preferredcodec": "mp3",
            "preferredquality": "192",
        }]

    return opts

def download_media(url, output_dir, quality="best", extract_audio=False, progress_callback=None):
    """下载媒体文件（视频/音频）
    返回：(成功标志, 消息, 文件路径列表)
    """
    try:
        from yt_dlp import YoutubeDL

        def progress_hook(d):
            if d["status"] == "downloading":
                try:
                    total = d.get("total_bytes") or d.get("total_bytes_estimate", 0)
                    downloaded = d.get("downloaded_bytes", 0)
                    if total > 0 and progress_callback:
                        progress_callback(downloaded, total)
                except:
                    pass

        opts = _get_ydl_opts(output_dir, quality, extract_audio)
        opts["progress_hooks"] = [progress_hook]

        with YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=False)
            if info is None:
                return False, "无法解析链接，请检查URL是否正确", []

            title = info.get("title", "未知标题")
            entries = info.get("entries", None)
            if entries is not None:
                total = len(entries)
                downloaded_files = []
                for idx, entry in enumerate(entries):
                    if entry is None:
                        continue
                    try:
                        ydl.download([entry["webpage_url"]])
                        _f = find_file(output_dir, entry)
                        if _f:
                            downloaded_files.append(_f)
                    except:
                        pass
                    if progress_callback:
                        progress_callback(idx + 1, total)
                return True, f"合集下载完成，共 {len(downloaded_files)} 个文件", downloaded_files
            else:
                # 直接 extract_info with download=True 下载并返回信息
                result = ydl.extract_info(url, download=True)
                if result:
                    f = find_file(output_dir, result)
                    title = result.get("title", title)
                    if not f:
                        f = find_file(output_dir, {})
                    files_list = [f] if f else []
                    return (True, f"下载完成: {title}", files_list)
                return True, "下载完成", []

    except Exception as e:
        error_msg = str(e)
        if "Unsupported URL" in error_msg:
            return False, "不支持该链接，请检查平台是否兼容", []
        elif "HTTP Error 403" in error_msg:
            return False, "访问被拒绝(403)，链接可能已失效或需登录", []
        elif "private" in error_msg.lower() or "login" in error_msg.lower():
            return False, "该内容为私密/需要登录才能下载", []
        elif "copyright" in error_msg.lower():
            return False, "该视频受版权保护，无法下载", []
        elif "No video formats found" in error_msg:
            return False, "未找到可下载的视频格式，链接可能失效", []
        elif "timed out" in error_msg.lower() or "timeout" in error_msg.lower():
            return False, "连接超时，请检查网络后重试", []
        return False, f"下载失败: {error_msg[:200]}", []


def find_file(output_dir, info=None):
    """找到最近下载的视频文件（取匹配 id 或最新 mp4）"""
    video_id = (info or {}).get("id", "")

    if not os.path.isdir(output_dir):
        return None

    # 精确匹配 video_id（最可靠）
    for f in os.listdir(output_dir):
        fp = os.path.join(output_dir, f)
        if not os.path.isfile(fp):
            continue
        ext = os.path.splitext(f)[1].lower()
        if ext not in (".mp4", ".mkv", ".webm", ".mov"):
            continue
        if video_id and video_id in f:
            return fp

    # 取最新修改时间的视频文件
    import time
    now = time.time()
    best = None
    best_age = float("inf")
    for f in os.listdir(output_dir):
        fp = os.path.join(output_dir, f)
        if not os.path.isfile(fp):
            continue
        ext = os.path.splitext(f)[1].lower()
        if ext not in (".mp4", ".mkv", ".webm", ".mov"):
            continue
        age = now - os.path.getmtime(fp)
        if age < best_age:
            best_age = age
            best = fp

    return best

# ==================== 平台检测与URL解析 ====================

PLATFORM_PATTERNS = [
    ("抖音/TikTok", ["douyin.com", "tiktok.com", "iesdouyin.com"]),
    ("快手", ["kuaishou.com", "kwai.com"]),
    ("小红书", ["xiaohongshu.com", "xhslink.com"]),
    ("X/Twitter", ["twitter.com", "x.com"]),
    ("B站", ["bilibili.com", "b23.tv"]),
    ("YouTube", ["youtube.com", "youtu.be"]),
    ("微博", ["weibo.com"]),
]


def detect_platform(url):
    """检测链接对应的平台"""
    url_lower = url.lower()
    for platform, domains in PLATFORM_PATTERNS:
        for domain in domains:
            if domain in url_lower:
                return platform
    return "其他"


# ==================== 文案提取 ====================

def extract_caption(url, timeout=15):
    """提取视频/帖子的文案描述"""
    try:
        from yt_dlp import YoutubeDL
        opts = {
            "quiet": True, "no_warnings": True,
            "extract_flat": True, "ignoreerrors": True,
            "socket_timeout": timeout,
        }
        with YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=False)
            if info is None:
                return False, ""

            title = info.get("title", "")
            description = info.get("description", "") or ""
            caption = title
            if description:
                clean_desc = re.sub(r"https?://\S+", "", description)
                clean_desc = re.sub(r"#\S+", "", clean_desc)
                clean_desc = clean_desc.strip()
                if clean_desc and clean_desc != title:
                    caption = title + "\n" + clean_desc
            return True, caption.strip()
    except Exception as e:
        return False, str(e)


# ==================== 下载图片 ====================

def download_images(url, output_dir, progress_callback=None):
    """从帖子链接下载图片"""
    try:
        from yt_dlp import YoutubeDL
        opts = {
            "quiet": True, "no_warnings": True,
            "extract_flat": False, "ignoreerrors": True,
            "outtmpl": os.path.join(output_dir, "%(id)s_%(page_number)s.%(ext)s"),
        }
        with YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=False)
            if info is None:
                return False, "无法解析链接", []

            entries = info.get("entries")
            if entries:
                downloaded = []
                total = len(entries)
                for idx, entry in enumerate(entries):
                    if entry is None:
                        continue
                    try:
                        ydl.download([entry["webpage_url"]])
                    except:
                        pass
                    if progress_callback:
                        progress_callback(idx + 1, total)
                return True, f"共 {len(downloaded)} 张图片", downloaded

            # 尝试缩略图
            thumbnails = info.get("thumbnails", [])
            if thumbnails:
                best_thumb = max(thumbnails, key=lambda x: x.get("height", 0) * x.get("width", 0) if x.get("height") else 0)
                thumb_url = best_thumb.get("url", "")
                if thumb_url:
                    import requests
                    resp = requests.get(thumb_url, timeout=15)
                    if resp.status_code == 200:
                        ext = Path(thumb_url.split("?")[0]).suffix or ".jpg"
                        fname = info.get("id", "image") + ext
                        fpath = os.path.join(output_dir, fname)
                        with open(fpath, "wb") as f:
                            f.write(resp.content)
                        return True, "封面图下载完成", [fpath]
            return False, "未找到可下载的图片", []
    except Exception as e:
        return False, f"图片下载失败: {str(e)}", []

# ==================== GUI 界面 ====================

class MediaToolFrame(ttk.Frame):
    """媒体下载工具界面"""

    def __init__(self, parent, theme):
        super().__init__(parent)
        self.theme = theme
        self.download_history = []
        self.last_output_dir = ""
        self._build_ui()

    def _build_ui(self):
        c = self.theme.colors

        # 标题
        title_frame = tk.Frame(self, bg=c["panel_bg"])
        title_frame.pack(fill="x", pady=(0, 10))
        tk.Label(title_frame, text="🌐 跨平台媒体下载器",
                 font=("Microsoft YaHei", 14, "bold"),
                 bg=c["panel_bg"], fg=c["fg"]).pack(anchor="w")
        tk.Label(title_frame, text="支持抖音/TikTok、快手、小红书、X/Twitter、B站、YouTube等",
                 font=("Microsoft YaHei", 8),
                 bg=c["panel_bg"], fg="#888888").pack(anchor="w")

        # 主内容区
        main_area = tk.Frame(self, bg=c["panel_bg"])
        main_area.pack(fill="both", expand=True)

        # 左半部分
        left_panel = tk.Frame(main_area, bg=c["panel_bg"])
        left_panel.pack(side="left", fill="both", expand=True, padx=(0, 10))

        # 链接输入
        tk.Label(left_panel, text="帖子/视频链接：", font=("Microsoft YaHei", 9),
                 bg=c["panel_bg"], fg=c["fg"], anchor="w").pack(fill="x")
        link_frame = tk.Frame(left_panel, bg=c["panel_bg"])
        link_frame.pack(fill="x", pady=(0, 8))
        self.url_entry = tk.Text(link_frame, height=3, font=("Microsoft YaHei", 10),
                                  bg=c["input_bg"], fg=c["fg"],
                                  relief="solid", bd=1, wrap="word")
        self.url_entry.pack(fill="both", expand=True, side="left")
        paste_btn = tk.Button(link_frame, text="📋 粘贴", command=self._paste_url,
                              bg=c["accent"], fg="white",
                              font=("Microsoft YaHei", 9), relief="flat",
                              padx=8, pady=2, cursor="hand2")
        paste_btn.pack(side="right", padx=(5, 0))

        # 下载选项
        options_frame = tk.LabelFrame(left_panel, text="下载选项",
                                       font=("Microsoft YaHei", 9, "bold"),
                                       bg=c["panel_bg"], fg=c["fg"],
                                       padx=10, pady=8)
        options_frame.pack(fill="x", pady=(0, 8))

        # 下载类型
        type_frame = tk.Frame(options_frame, bg=c["panel_bg"])
        type_frame.pack(fill="x", pady=2)
        tk.Label(type_frame, text="下载类型：", font=("Microsoft YaHei", 9),
                 bg=c["panel_bg"], fg=c["fg"]).pack(side="left")
        self.dl_type = tk.StringVar(value="video")
        for val, txt in [("video", "🎬 视频"), ("image", "🖼️ 图片"),
                          ("caption", "📝 文案"), ("audio", "🎵 音频")]:
            tk.Radiobutton(type_frame, text=txt, variable=self.dl_type,
                           value=val, bg=c["panel_bg"], fg=c["fg"],
                           selectcolor=c["input_bg"], font=("Microsoft YaHei", 9)).pack(side="left", padx=3)

        # 视频质量
        quality_frame = tk.Frame(options_frame, bg=c["panel_bg"])
        quality_frame.pack(fill="x", pady=2)
        tk.Label(quality_frame, text="视频质量：", font=("Microsoft YaHei", 9),
                 bg=c["panel_bg"], fg=c["fg"]).pack(side="left")
        self.quality_var = tk.StringVar(value="best")
        quality_menu = ttk.Combobox(quality_frame, textvariable=self.quality_var,
                                     values=["最佳画质", "1080p", "720p", "480p"],
                                     state="readonly", width=14, font=("Microsoft YaHei", 9))
        quality_menu.pack(side="left", padx=5)
        quality_menu.current(0)

        # 输出目录
        dir_frame = tk.Frame(left_panel, bg=c["panel_bg"])
        dir_frame.pack(fill="x", pady=(0, 8))
        tk.Label(dir_frame, text="保存到：", font=("Microsoft YaHei", 9),
                 bg=c["panel_bg"], fg=c["fg"]).pack(side="left")
        self.dir_var = tk.StringVar(value=os.path.join(os.path.expanduser("~"), "Desktop", "极简办公_下载"))
        dir_entry = tk.Entry(dir_frame, textvariable=self.dir_var,
                              font=("Microsoft YaHei", 9),
                              bg=c["input_bg"], fg=c["fg"],
                              relief="solid", bd=1)
        dir_entry.pack(side="left", fill="x", expand=True, padx=(5, 5))
        tk.Button(dir_frame, text="📂 选择", command=self._choose_dir,
                  bg=c["accent"], fg="white",
                  font=("Microsoft YaHei", 9), relief="flat",
                  padx=8, pady=2, cursor="hand2").pack(side="right")

        # 下载按钮
        self.btn_download = tk.Button(left_panel, text="🚀 开始下载",
                                       command=self._start_download,
                                       bg="#0F9D58", fg="white",
                                       font=("Microsoft YaHei", 12, "bold"),
                                       relief="flat", padx=20, pady=8,
                                       cursor="hand2")
        self.btn_download.pack(fill="x", pady=(5, 5))

        # 进度条
        progress_frame = tk.Frame(left_panel, bg=c["panel_bg"])
        progress_frame.pack(fill="x", pady=(0, 5))
        self.progress_var = tk.DoubleVar()
        self.progress_bar = ttk.Progressbar(progress_frame, variable=self.progress_var, maximum=100)
        self.progress_bar.pack(fill="x")
        self.status_var = tk.StringVar(value="就绪")
        tk.Label(progress_frame, textvariable=self.status_var,
                 font=("Microsoft YaHei", 8),
                 bg=c["panel_bg"], fg="#888888").pack(anchor="w")

        # 右半部分
        right_panel = tk.Frame(main_area, bg=c["panel_bg"])
        right_panel.pack(side="right", fill="both", expand=True)

        tk.Label(right_panel, text="📋 下载记录", font=("Microsoft YaHei", 9, "bold"),
                 bg=c["panel_bg"], fg=c["fg"], anchor="w").pack(fill="x")

        result_frame = tk.Frame(right_panel, bg=c["panel_bg"])
        result_frame.pack(fill="both", expand=True)
        self.result_text = tk.Text(result_frame, font=("Microsoft YaHei", 9),
                                    bg=c["input_bg"], fg=c["fg"],
                                    relief="solid", bd=1, wrap="word",
                                    state="disabled")
        self.result_text.pack(fill="both", expand=True, side="left")
        result_scrollbar = tk.Scrollbar(result_frame, command=self.result_text.yview)
        result_scrollbar.pack(side="right", fill="y")
        self.result_text.config(yscrollcommand=result_scrollbar.set)

        # 底部按钮
        action_frame = tk.Frame(right_panel, bg=c["panel_bg"])
        action_frame.pack(fill="x", pady=(5, 0))

        self.btn_open_dir = tk.Button(action_frame, text="📂 打开下载目录",
                                       command=self._open_output_dir,
                                       bg=c["accent"], fg="white",
                                       font=("Microsoft YaHei", 9), relief="flat",
                                       padx=10, pady=4, cursor="hand2",
                                       state="disabled")
        self.btn_open_dir.pack(side="left", padx=(0, 5))

        self.btn_caption = tk.Button(action_frame, text="📋 复制文案",
                                      command=self._copy_last_caption,
                                      bg="#0F9D58", fg="white",
                                      font=("Microsoft YaHei", 9), relief="flat",
                                      padx=10, pady=4, cursor="hand2",
                                      state="disabled")
        self.btn_caption.pack(side="left", padx=(0, 5))

        tk.Button(action_frame, text="🗑️ 清空", command=self._clear_log,
                  bg=c["warning"], fg="white",
                  font=("Microsoft YaHei", 9), relief="flat",
                  padx=10, pady=4, cursor="hand2").pack(side="left")

        # 帮助信息
        help_frame = tk.LabelFrame(left_panel, text="📖 使用说明",
                                    font=("Microsoft YaHei", 9, "bold"),
                                    bg=c["panel_bg"], fg=c["fg"],
                                    padx=10, pady=5)
        help_frame.pack(fill="x")
        help_text = (
            "1. 复制帖子/视频链接到输入框\n"
            "2. 选择下载类型(视频/图片/文案/音频)\n"
            "3. 选择视频画质(视频模式下)\n"
            "4. 点击「开始下载」\n\n"
            "✅ 支持：抖音、TikTok、快手、小红书、\n"
            "   X/Twitter、B站、YouTube、微博\n"
            "✅ yt-dlp自动去水印处理\n"
            "✅ 支持720p/1080p等多种画质"
        )
        tk.Label(help_frame, text=help_text,
                 font=("Microsoft YaHei", 8),
                 bg=c["panel_bg"], fg="#888888",
                 justify="left", anchor="w").pack(fill="x")

        self._last_caption = ""
        self._append_log("🟢 媒体下载器已就绪\n粘贴链接即可开始下载")

    def _paste_url(self):
        try:
            clipboard = self.clipboard_get()
            if clipboard:
                self.url_entry.delete("1.0", "end")
                self.url_entry.insert("1.0", clipboard.strip())
        except:
            pass

    def _choose_dir(self):
        d = filedialog.askdirectory(title="选择下载保存目录")
        if d:
            self.dir_var.set(d)

    def _append_log(self, text):
        self.result_text.config(state="normal")
        self.result_text.insert("end", text + "\n")
        self.result_text.see("end")
        self.result_text.config(state="disabled")

    def _clear_log(self):
        self.result_text.config(state="normal")
        self.result_text.delete("1.0", "end")
        self.result_text.config(state="disabled")
        self.btn_open_dir.config(state="disabled")
        self.btn_caption.config(state="disabled")

    def _open_output_dir(self):
        if self.last_output_dir and os.path.exists(self.last_output_dir):
            os.startfile(self.last_output_dir)
        elif self.dir_var.get():
            os.makedirs(self.dir_var.get(), exist_ok=True)
            os.startfile(self.dir_var.get())

    def _copy_last_caption(self):
        if self._last_caption:
            self.clipboard_clear()
            self.clipboard_append(self._last_caption)
            self._append_log("✅ 文案已复制到剪贴板")
            self.status_var.set("✅ 文案已复制到剪贴板")
        else:
            messagebox.showinfo("提示", "暂无文案内容可复制")

    def _start_download(self):
        raw = self.url_entry.get("1.0", "end").strip()
        urls = parse_urls(raw)
        if not urls:
            messagebox.showwarning("提示", "未检测到链接，请粘贴正确的链接")
            return
        url = urls[0]

        dl_type = self.dl_type.get()
        output_dir = self.dir_var.get().strip()
        if not output_dir:
            output_dir = os.path.join(os.path.expanduser("~"), "Desktop", "极简办公_下载")
        os.makedirs(output_dir, exist_ok=True)

        platform = detect_platform(url)
        self._append_log(f"🔍 检测到平台: {platform}")
        self._append_log(f"📁 保存到: {output_dir}")
        self._append_log(f"🎯 下载模式: {dl_type}")

        quality_map = {"最佳画质": "best", "1080p": "1080p", "720p": "720p", "480p": "480p"}
        quality = quality_map.get(self.quality_var.get(), "best")
        self._append_log(f"🎬 视频画质: {self.quality_var.get()}")

        self.btn_download.config(state="disabled", text="⏳ 下载中...")
        self.progress_var.set(0)
        self.status_var.set("正在下载...")

        thread = threading.Thread(
            target=self._process_download,
            args=(url, output_dir, dl_type, quality), daemon=True
        )
        thread.start()

    def _process_download(self, url, output_dir, dl_type, quality):
        try:
            if dl_type == "caption":
                self._download_caption(url, output_dir)
            elif dl_type == "image":
                self._download_images(url, output_dir)
            elif dl_type == "audio":
                self._download_audio(url, output_dir, quality)
            else:
                self._download_video(url, output_dir, quality)
        except Exception as e:
            self.after(0, lambda: self._append_log(f"❌ 错误: {str(e)}"))
            self.after(0, lambda: self.status_var.set("下载失败"))
        finally:
            self.after(0, lambda: self.btn_download.config(state="normal", text="🚀 开始下载"))

    def _download_video(self, url, output_dir, quality):
        def progress_cb(current, total):
            if total > 0:
                pct = min(current / total * 100, 99)
                self.after(0, lambda: self.progress_var.set(pct))

        success, msg, files = download_media(url, output_dir, quality, False, progress_cb)
        self.after(0, lambda: self._append_log(f"{'✅' if success else '❌'} {msg}"))
        if success and files:
            self.last_output_dir = output_dir
            self.after(0, lambda: self.btn_open_dir.config(state="normal"))
            for f in files[:5]:
                size = os.path.getsize(f) / 1024 / 1024 if os.path.exists(f) else 0
                self.after(0, lambda f=f, s=size: self._append_log(f"  📄 {os.path.basename(f)} ({s:.1f} MB)"))
            if len(files) > 5:
                self.after(0, lambda: self._append_log(f"  ... 共 {len(files)} 个文件"))
        self.after(0, lambda: self.progress_var.set(100))
        self.after(0, lambda: self.status_var.set("下载完成 ✅" if success else "下载失败 ❌"))

    def _download_images(self, url, output_dir):
        def progress_cb(current, total):
            if total > 0:
                self.after(0, lambda: self.progress_var.set(current / total * 100))

        success, msg, files = download_images(url, output_dir, progress_cb)
        self.after(0, lambda: self._append_log(f"{'✅' if success else '❌'} {msg}"))
        if success and files:
            self.last_output_dir = output_dir
            self.after(0, lambda: self.btn_open_dir.config(state="normal"))
        self.after(0, lambda: self.progress_var.set(100))
        self.after(0, lambda: self.status_var.set("下载完成 ✅" if success else "下载失败 ❌"))

    def _download_audio(self, url, output_dir, quality):
        def progress_cb(current, total):
            if total > 0:
                self.after(0, lambda: self.progress_var.set(current / total * 100))

        success, msg, files = download_media(url, output_dir, quality, True, progress_cb)
        self.after(0, lambda: self._append_log(f"{'✅' if success else '❌'} {msg}"))
        if success and files:
            self.last_output_dir = output_dir
            self.after(0, lambda: self.btn_open_dir.config(state="normal"))
        self.after(0, lambda: self.progress_var.set(100))
        self.after(0, lambda: self.status_var.set("下载完成 ✅" if success else "下载失败 ❌"))

    def _download_caption(self, url, output_dir):
        self.after(0, lambda: self.status_var.set("正在提取文案..."))
        success, caption = extract_caption(url)

        if success and caption:
            self._last_caption = caption
            ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            txt_path = os.path.join(output_dir, f"文案_{ts}.txt")
            with open(txt_path, "w", encoding="utf-8") as f:
                f.write(caption)

            self.after(0, lambda: self._append_log("✅ 文案提取成功"))
            preview = caption[:200] + ("..." if len(caption) > 200 else "")
            self.after(0, lambda: self._append_log(f"📝 {preview}"))
            self.after(0, lambda: self._append_log(f"💾 已保存到: {txt_path}"))
            self.after(0, lambda: self.btn_caption.config(state="normal"))
            self.last_output_dir = output_dir
            self.after(0, lambda: self.btn_open_dir.config(state="normal"))
            self.after(0, lambda: self.status_var.set("文案已提取 ✅"))
        else:
            self.after(0, lambda: self._append_log(f"❌ 文案提取失败: {caption}"))
            self.after(0, lambda: self.status_var.set("文案提取失败 ❌"))
        self.after(0, lambda: self.progress_var.set(100))

    def apply_theme(self):
        c = self.theme.colors
        try:
            self.url_entry.config(bg=c["input_bg"], fg=c["fg"])
            self.result_text.config(bg=c["input_bg"], fg=c["fg"])
        except:
            pass
